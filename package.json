{
    "name": "livedog-monorepo",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "frontend",
        "backend"
    ],
    "scripts": {
        "setup": "bun run scripts/setup.js",
        "dev": "bun run --parallel dev:*",
        "dev:frontend": "cd frontend && bun run dev",
        "dev:backend": "cd backend && bun run dev",
        "docker:full": "docker compose --profile full up",
        "docker:backend": "docker compose up",
        "docker:down": "docker compose down",
        "docker:build": "docker compose build",
        "docker:logs": "docker compose logs -f",
        "build": "bun run build:frontend && bun run build:backend",
        "build:frontend": "cd frontend && bun run build",
        "build:backend": "cd backend && bun run build",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,vue,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,vue,json,md}\"",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.2.4"
    },
    "dependencies": {
        "dev": "^0.1.3"
    }
}
